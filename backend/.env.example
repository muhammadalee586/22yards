# --- Django Settings ---
DEBUG=False # Set to True for development
SECRET_KEY= # Mandatory secret key for Django
ALLOWED_HOSTS=localhost,127.0.0.1 # Comma-separated list of hosts

# --- MySQL Database Configuration ---
DB_NAME= # Database name
DB_USER= # Database user
DB_PASSWORD= # Database password
DB_HOST=localhost
DB_PORT=3306

# --- JWT Security Settings ---
JWT_ACCESS_TOKEN_LIFETIME= # Access token lifetime in minutes
JWT_REFRESH_TOKEN_LIFETIME= # Refresh token lifetime in days
JWT_ROTATE_REFRESH_TOKENS=True # Whether to rotate refresh tokens
JWT_BLACKLIST_AFTER_ROTATION=True # Blacklist old tokens after rotation

# --- Google OAuth Settings ---
GOOGLE_CLIENT_ID= # Google Client ID
GOOGLE_CLIENT_SECRET= # Google Client Secret

# --- Email Configuration ---
EMAIL_HOST= # SMTP server host
EMAIL_PORT= # SMTP server port
EMAIL_USE_TLS=True # Use TLS for email
EMAIL_HOST_USER= # Email sender address
EMAIL_HOST_PASSWORD= # Email app password

# --- Payment Gateway ---
STRIPE_SECRET_KEY= # Stripe Secret Key
STRIPE_WEBHOOK_SECRET= # Stripe Webhook Signing Secret
